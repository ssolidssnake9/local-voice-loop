# PORTABILITY NOTE: replace every /home/hatch with your own home dir before installing (see README).
# Voice loop: Ollama LLM server (:11434, llama3.2:3b)
# Source of truth lives at ~/workspace/systemd/voice-loop-ollama.service
# (persistent). The watchdog reinstalls it to /etc/systemd/system/ if wiped.
[Unit]
Description=Voice loop Ollama LLM server (:11434)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hatch/workspace/ollama
Environment=HOME=/home/hatch
Environment=TMPDIR=/home/hatch/workspace/.tmp
Environment=OLLAMA_MODELS=/home/hatch/.ollama/models
Environment=OLLAMA_HOST=http://127.0.0.1:11434
ExecStart=/home/hatch/workspace/ollama/bin/ollama serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
